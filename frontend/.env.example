# Copy to .env.local (gitignored). Only VITE_ values reach the browser — never put AWS keys here.

# API Gateway stage URL from Advait, e.g. https://abc123.execute-api.us-west-2.amazonaws.com/prod
# Leave empty to use the built-in mock backend.
VITE_API_BASE=

# Force mock mode even when VITE_API_BASE is set (true/false)
VITE_USE_MOCK=false

# Which user's inventory to load (the pre-loaded demo account)
VITE_DEMO_USER=demo
